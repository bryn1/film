# Kopiera den här filen till .env.local och fyll i din TMDB-nyckel.
# .env.local läses av Next.js automatiskt och är redan ignorerad av git (nyckeln hamnar aldrig i repot).
# Hämta en kostnadsfri nyckel: TMDB → Inställningar → API ("Read Access Token" v3).

# Krävs för att sajten ska visa riktiga filmer. Utan nyckel visar sajten en
# tydlig "Kan inte visa filmer"-state — den kraschar inte.
TMDB_API_KEY=din_nyckel_här

# Valfritt — standardvärdena nedan används om du tar bort raderna.
# TMDB_BASE_URL=https://api.themoviedb.org/3
# TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
